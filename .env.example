# Leave Supabase vars empty to run in DEMO MODE (seed data in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── E-mail notifications (optional) — all five are server-only; never prefix them with NEXT_PUBLIC_ ──
RESEND_API_KEY=
# Until you verify your own domain in Resend, use the default sender below and send only to YOUR OWN Resend account e-mail.
RESEND_FROM="SpeechSearch <onboarding@resend.dev>"
ADMIN_NOTIFY_EMAIL=
SUPABASE_SERVICE_ROLE_KEY=
# Used for links inside e-mails (defaults to the request's origin)
NEXT_PUBLIC_SITE_URL=

# Shown in the privacy policy / accessibility statement
NEXT_PUBLIC_CONTACT_EMAIL=
# Production builds disable demo mode; set to "true" only to publish a public DEMO (fake accounts, browser-only data)
NEXT_PUBLIC_ALLOW_DEMO=
